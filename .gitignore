.venv/
venv/
__pycache__/
*.pyc
.env
*.egg-info/
build/
dist/

# Local clone of the Hugging Face Space repo used for deploying demo/.
# It is its own git repo - if it isn't ignored here, running `git add -A`
# from the project root swallows it as an accidental submodule (and pulls
# in any stray copy folder alongside it).
redactguard/
space-repo/

# data / outputs (synthetic data is regenerable, keep repo small)
data/synthetic_docs/*
data/labels/*
data/sft_train.jsonl
data/dpo_pairs.jsonl
!data/synthetic_docs/.gitkeep
!data/labels/.gitkeep
outputs/
*.pdf
!tests/fixtures/*.pdf
# The sample document is committed on purpose - it's what someone visiting
# the live demo uploads to try it, and it's regenerable via
# samples/generate_sample.py.
!samples/*.pdf

# eval results are resume evidence - keep them tracked
!eval/results_*.json

# model artifacts
phase3_finetune/*_adapter/
phase3_finetune/final_adapter/
*.safetensors
*.bin

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# logs
*.log

# Held-out test split. Kept out of the SFT/DPO training corpus by living in a
# separate directory - prepare_sft_dataset.py only ever reads
# data/synthetic_docs, so these documents cannot leak into training.
data/heldout_docs/*
data/heldout_labels/*
!data/heldout_docs/.gitkeep
!data/heldout_labels/.gitkeep
