# Copy this file to .env and fill in real values. Never commit .env.

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys (fallback LLM, and used to decorrelate
# eval-generation from detection so eval numbers aren't "a model grading itself")
GROQ_API_KEY=

# Below have sane defaults in app/config.py - override here only if needed.
# CONFIDENCE_THRESHOLD=0.7
# LLM_DETECTOR_PROVIDER=gemini
# EVAL_GENERATOR_PROVIDER=groq
# MAX_REDACT_RETRIES=2
