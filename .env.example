# Copy this file to .env and fill in real values. Never commit .env.

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional third provider -------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. Providers are tried in
# PROVIDER_CHAIN order and ALL are attempted before detection gives up - a
# single fallback proved insufficient when both free tiers hit their daily
# limits mid-evaluation.
#
# Leave OPENAI_COMPAT_BASE_URL blank and the chain simply skips this slot.
#
# Known-working examples:
#   OpenRouter (has genuinely free models):
#     OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
#     OPENAI_COMPAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Mistral:
#     OPENAI_COMPAT_BASE_URL=https://api.mistral.ai/v1
#     OPENAI_COMPAT_MODEL=mistral-small-latest
#   Cerebras — NOTE: verified 2026-09-03 as returning HTTP 402
#   (payment required) on the free tier, so it needs billing enabled:
#     OPENAI_COMPAT_BASE_URL=https://api.cerebras.ai/v1
#     OPENAI_COMPAT_MODEL=gpt-oss-120b
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# Below have sane defaults in app/config.py - override here only if needed.
# PROVIDER_CHAIN=gemini,groq,openai_compat
# CONFIDENCE_THRESHOLD=0.7
# LLM_DETECTOR_PROVIDER=gemini
# EVAL_GENERATOR_PROVIDER=groq
# MAX_REDACT_RETRIES=2
# LOCAL_ADAPTER_PATH=phase3_finetune/final_adapter
